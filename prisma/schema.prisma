// Fraterniti One — Phase 1 data model.
// Grounded in plan.md section 4 (approved 2026-09-15 by Apoorv) and
// SRD sections 2 (roles), 3 (lifecycle stages), 7 (status masters), 8 (core entities).
// Phase 2+ entities (Milestone, Approval, Payment, Vendor/PO, DPR, Issue/Dependency,
// Employee/Hiring, MarketingActivity) are intentionally NOT modeled yet — see plan.md section 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider           = "postgresql"
  url                = env("DATABASE_URL")
  // `migrate dev`'s shadow-database step needs CREATEDB, which the native
  // Postgres role backing DATABASE_URL (port 5432) doesn't have. Point it at
  // the docker-compose Postgres instead (port 5433, docker-compose.yml) —
  // that container's user is a real superuser, and it's already sitting
  // there unused for exactly this workflow.
  shadowDatabaseUrl  = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// SRD section 2 — User Roles and Permissions.
enum Role {
  FRANCHISEE
  SALES
  LEGAL
  INTERIORS
  PROJECT_MANAGER
  ACCOUNTS
  HR
  CULINARY
  MARKETING
  OPERATIONS
  MANAGEMENT
  ADMIN
  /// plan.md section 16 (mobile field interface, decided 2026-09-24) — site
  /// supervisors upload progress photos/videos from `/m`. Access is scoped by
  /// `ProjectMember`, not the department matrix in role-departments.ts (a
  /// supervisor spans every BOQ trade on their assigned site, not one
  /// department), and login is phone+PIN, not email+password (see
  /// `User.phone`/`User.pinHash` below).
  SITE_SUPERVISOR
}

/// Department taxonomy, used both for Task.module (SRD section 8: "task_id,
/// project_id, module, ...") and Document.category (SRD section 5: "Folder
/// taxonomy by department"). PROPERTY/PROCUREMENT/GENERAL/FRANCHISEE are
/// included alongside the department-shaped roles above because SRD section 3
/// names "Property/Site" and "Culinary & Procurement" as distinct lifecycle
/// stages/work areas even though they don't each have their own Role.
enum Department {
  SALES
  LEGAL
  PROPERTY
  INTERIORS
  PROJECTS
  ACCOUNTS
  HR
  CULINARY
  PROCUREMENT
  MARKETING
  OPERATIONS
  FRANCHISEE
  GENERAL
}

/// SRD section 3 — End-to-End Franchise Lifecycle, regrouped 2026-09-18 to
/// match the franchise lifecycle tracker sheet (13 stages, independent/
/// parallel — no longer a single project-wide "current stage": each stage's
/// status is derived from its own Task.lifecycleStage set, see Task below
/// and ProjectStageOverride for the admin force-complete escape hatch).
enum LifecycleStage {
  SALES_FRANCHISE_ACQUISITION
  LOCATION_ACQUISITION
  LEGAL_COMPLIANCE
  PROJECT_HANDOVER
  DESIGN
  BOQ_PROCUREMENT
  CONSTRUCTION_EXECUTION
  LICENSING
  OPERATIONS_PREPARATION
  TECHNOLOGY_DEPLOYMENT
  PRE_LAUNCH_MARKETING
  GRAND_LAUNCH
  POST_OPENING
}

/// SRD section 7 — Status, SLA and Escalation Model: "Project Health".
/// Manually set for Phase 1; automatic readiness-score-driven health is
/// Phase 4 (plan.md section 2).
enum ProjectHealth {
  GREEN
  AMBER
  RED
  CRITICAL
}

/// SRD section 7 — Status, SLA and Escalation Model: "Task".
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_FRANCHISEE
  AWAITING_INTERNAL
  BLOCKED
  COMPLETED
  CANCELLED
}

/// Not explicitly enumerated for Task in the SRD. Reused from the Blocker
/// priority scale (SRD section 6, Delay & Dependency Engine: "Critical, High,
/// Medium, Low") as the closest documented precedent — flagged as an
/// inference, not a verbatim spec value. Easy to change later since it's a
/// single enum.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// SRD section 7 — Status, SLA and Escalation Model: "Document".
enum DocumentStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

/// SRD section 8: AuditEvent "action". Kept intentionally small for Phase 1 —
/// extend as new mutation types are added.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

/// INVITE: admin created the account with no password yet — link sets the
/// first one. RESET: existing user asked for a new one via "Forgot
/// password". Same token mechanism, different email copy + expiry window.
enum PasswordResetPurpose {
  INVITE
  RESET
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// SRD section 8: "User / Organisation — user_id, organisation, role,
/// permissions, contact, project access". Organisation/multi-org access is
/// out of scope for Phase 1 (single-brand, plan.md section 5 decisions).
model User {
  id    String  @id @default(cuid())
  name  String
  /// Optional as of plan.md section 16 (2026-09-24): a site supervisor logs
  /// in with phone+PIN and may have no email at all. Still unique when
  /// present — Postgres allows multiple NULLs under a unique constraint, so
  /// this doesn't collide across supervisor accounts. Every pre-existing user
  /// keeps their email untouched; this migration only widens the column.
  email String? @unique
  /// Site-supervisor login credential (plan.md section 16, decision 7: phone
  /// + PIN, no OTP/SMS). Hashed the same way as passwordHash — never store
  /// the raw PIN. Null for every non-supervisor account.
  phone String? @unique
  /// Nullable: an admin-created user (see PasswordResetToken, purpose
  /// INVITE) starts with no password until they follow their setup link.
  /// login() treats a null hash the same as a wrong password — no separate
  /// error message — so this doesn't become a way to enumerate which emails
  /// exist in the system.
  passwordHash String?
  /// Hashed PIN for phone-based supervisor login (plan.md section 16). Same
  /// null-means-"can't log in yet" discipline as passwordHash.
  pinHash      String?
  /// Brute-force lockout for phone+PIN login (plan.md section 16, "NOT
  /// DECIDED YET" item 3, resolved 2026-09-24: 5 wrong attempts -> 15-minute
  /// lock). Reset to 0/null on a correct login, and by the admin's
  /// "Reset PIN" action. Unused by every other login path (email+password has
  /// no lockout — out of scope for this section).
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  role         Role
  department   Department?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions            Session[]
  ownedProjects       FranchiseProject[]     @relation("ProjectOwner")
  franchiseeProjects  FranchiseProject[]     @relation("ProjectFranchisee")
  tasksOwned          Task[]                 @relation("TaskOwner")
  tasksCreated        Task[]                 @relation("TaskCreatedBy")
  taskComments        TaskComment[]
  documentsOwned      Document[]             @relation("DocumentOwner")
  auditEvents         AuditEvent[]
  passwordResetTokens PasswordResetToken[]
  stageOverridesDone  ProjectStageOverride[]
  /// Which projects a SITE_SUPERVISOR can see/act on (plan.md section 16,
  /// decision 3: "one project = one chat"). Empty for every other role.
  projectMemberships  ProjectMember[]
}

/// Backs both the admin "invite" flow and self-service "forgot password"
/// (plan.md build log, 2026-09-18). Same hashing discipline as Session: only
/// tokenHash is stored, so a DB leak alone can't be replayed as a live link.
model PasswordResetToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   PasswordResetPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

/// Database-backed session (decision: session-based auth, plan.md section 5).
/// The cookie holds an opaque random token; only its SHA-256 hash is stored
/// here, so a database leak alone can't be replayed as a valid session.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// SRD section 8: "FranchiseProject — project_id, brand, format,
/// franchisee_id, location, target_opening, forecast_opening,
/// lifecycle_stage, health". The one entity everything else attaches to
/// (plan.md section 4) — every other Phase 1 model carries a projectId.
model FranchiseProject {
  id              String        @id @default(cuid())
  /// Autoincrementing sequence backing the human-readable project code
  /// (formatted at the application layer, e.g. "FR-00001"), kept separate
  /// from the cuid primary key used in URLs.
  seq             Int           @unique @default(autoincrement())
  /// Single-brand hardcode for Phase 1 (plan.md section 5 decision) — plain
  /// string field, not a Brand entity, so it normalizes later without
  /// breaking this relationship.
  brand           String        @default("Tulsi")
  format          String
  franchiseeId    String
  franchisee      User          @relation("ProjectFranchisee", fields: [franchiseeId], references: [id])
  location        String
  health          ProjectHealth @default(GREEN)
  targetOpening   DateTime
  forecastOpening DateTime?
  /// FR-002: "current owner and next action visible on ... dashboards".
  ownerId         String
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  nextAction      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tasks          Task[]
  documents      Document[]
  auditEvents    AuditEvent[]
  stageOverrides ProjectStageOverride[]
  members        ProjectMember[]

  @@index([franchiseeId])
  @@index([ownerId])
}

/// Site-supervisor project access (plan.md section 16, decision 3: "one
/// project = one chat"). Presence of a row = that supervisor can see and
/// upload against that project on `/m`; this is the server-side gate on
/// every `/m` page/action, checked in addition to (not instead of) the
/// existing role-based checks in permissions.ts — a supervisor spanning
/// several sites gets one row per site, not a role-wide grant.
model ProjectMember {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

/// SRD section 8: "Task — task_id, project_id, module, owner, due, priority,
/// status, dependency, completion evidence". FR-003.
model Task {
  id             String           @id @default(cuid())
  projectId      String
  project        FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Department this task belongs to — added to the data model per Apoorv's
  /// 2026-09-15 review (plan.md section 4), and confirmed present in SRD
  /// section 8's own Task field list ("module").
  module         Department
  /// Which of the 13 lifecycle stages this task belongs to (added alongside
  /// `module` 2026-09-18) — orthogonal to `module`/Department: module still
  /// drives who can manage the task, lifecycleStage drives which stage tile
  /// it shows up under and feeds that stage's derived status.
  lifecycleStage LifecycleStage
  /// Position within its (project, lifecycleStage) group — drives the
  /// swappable up/down ordering in the stage dialog (2026-09-19 addition).
  /// Seeded tasks get the sheet's order; ad-hoc tasks append to the end.
  order          Int              @default(0)
  /// Construction trade / ops department roll-up axis (plan.md section 9,
  /// decided 2026-09-21) — free-text, not an enum: the real BOQ/Ops master
  /// checklist carries ~28 distinct categories (AC Work, Electrical,
  /// Carpentry, Culinary, HR, ...), too granular for the 13-value
  /// `Department` enum that `module` uses for RBAC. Orthogonal to both
  /// `module` (who can manage it) and `lifecycleStage` (which stage tile it
  /// shows under) — nullable because the original ~150-item lifecycle
  /// checklist (STAGE_TASK_TEMPLATES) predates this axis and has no
  /// category of its own.
  category       String?
  title          String
  description    String?
  ownerId        String
  owner          User             @relation("TaskOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate        DateTime?
  priority       TaskPriority     @default(MEDIUM)
  status         TaskStatus       @default(NOT_STARTED)

  /// Self-referencing dependency link (SRD: "dependency").
  dependsOnId String?
  dependsOn   Task?   @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents  Task[]  @relation("TaskDependency")

  /// SRD: "completion evidence" — free-text note/link recorded on completion.
  completionEvidence String?
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  TaskComment[]
  /// Reverses plan.md section 9 decision #5 ("no Document.taskId FK") — see
  /// plan.md section 16, decision 9: a supervisor's upload attaches straight
  /// to the Task it's evidence for, not just the project.
  documents Document[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@index([lifecycleStage])
  @@index([category])
}

/// FR-003 acceptance criteria mentions comments as part of the task
/// workflow; SRD section 5 (Communication) treats task-linked comments as
/// part of that workflow too. Minimal model — no threading/mentions yet.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

/// Admin-only "force complete" escape hatch for a lifecycle stage (2026-09-18
/// addition): normally a stage's status is derived purely from its tasks
/// (see lifecycle-stage-status.ts), but the business can decide a stage is
/// done even with tasks still open (e.g. 7/11). Presence of a row = that
/// stage is force-completed for that project; deleting it reopens the stage.
model ProjectStageOverride {
  id            String           @id @default(cuid())
  projectId     String
  project       FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage         LifecycleStage
  completedById String
  completedBy   User             @relation(fields: [completedById], references: [id])
  createdAt     DateTime         @default(now())

  @@unique([projectId, stage])
  @@index([projectId])
}

/// SRD section 8: "Document — document_id, project, category, version, file,
/// status, owner, approval_ref". FR-005. Schema included now since the data
/// model is approved as a whole, but the create/upload UI is a separate
/// Phase 1 ticket per plan.md step 4 (not part of the initial vertical
/// slice) — see plan.md section 7.
model Document {
  id          String           @id @default(cuid())
  projectId   String
  project     FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Nullable (plan.md section 16, decision 9 — reverses section 9 decision
  /// #5): set when a document is evidence for one specific Task (e.g. a
  /// supervisor's upload from `/m`). Null for the pre-existing project-level
  /// vault documents, which are unaffected. `onDelete: SetNull` so a document
  /// is never deleted just because the Task it was attached to is gone — it
  /// falls back to being a plain project-level document.
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category    Department
  title       String
  version     Int              @default(1)
  /// Object key in the R2 bucket (plan.md section 5 decision). No signed
  /// URL is stored — generated on demand so access stays controlled.
  fileKey     String
  fileName    String
  fileSize    Int
  mimeType    String
  status      DocumentStatus   @default(DRAFT)
  ownerId     String
  owner       User             @relation("DocumentOwner", fields: [ownerId], references: [id])
  /// SRD: "approval_ref" — free-text stub until the Phase 2 approval engine
  /// exists (plan.md section 2).
  approvalRef String?

  /// Version history (SRD FR-005: "Latest approved version clearly
  /// identified"): each new version points back at the one it supersedes.
  supersedesId String?   @unique
  supersedes   Document? @relation("DocumentVersion", fields: [supersedesId], references: [id])
  supersededBy Document? @relation("DocumentVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([taskId])
}

/// SRD section 8: "AuditEvent — event_id, user, project, object, action,
/// old/new, timestamp, source". FR-010 — full audit log, not optional
/// (plan.md section 4 "cause -> effect that must hold").
///
/// actorEmail/actorName/actorRole are a denormalized snapshot taken at write
/// time, in addition to the actorId FK: NFR-06 requires an *immutable* event
/// history, which the FK alone can't guarantee once a user record changes or
/// is deactivated.
model AuditEvent {
  id        String            @id @default(cuid())
  projectId String?
  project   FranchiseProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorName  String
  actorRole  Role

  entityType String
  entityId   String
  action     AuditAction

  oldValue  Json?
  newValue  Json?
  /// SRD: "reference" — free-text pointer (e.g. a related record or note).
  reference String?
  source    String  @default("web")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
