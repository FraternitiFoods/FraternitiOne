// Fraterniti One — `new` branch baseline (see plan.md milestone M0).
//
// This branch drops every Phase 1 module (franchise lifecycle, onboarding/
// KYC/LOI e-sign, sales tracking, Petpooja POS, complaints, board digest,
// delays) to make room for the Site BOQ module. Only auth/users/roles
// survive from the old model — everything else starts fresh in M1+ (see
// plan.md section 3 for the BOQ data model). The removed models are still
// safe in git history on `main`/`dev`.

generator client {
  provider        = "prisma-client-js"
  // Collapses multi-relation `include` queries (e.g. getComputedItems,
  // getCurrentUser's session+user) into a single SQL query with real JOINs
  // instead of Prisma's default one-SQL-query-per-relation strategy — each
  // of those separate round trips pays full network latency to the remote
  // Neon DB (ap-southeast-1), which is what was actually making every page
  // slow (measured: getComputedItems alone fired 6 sequential queries).
  // Preview feature, not GA — but additive-only (opt in per query via
  // relationLoadStrategy: "join"), easy to revert.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider          = "postgresql"
  // Pooled connection (e.g. Neon's pgbouncer endpoint) — what the running
  // app/Prisma Client uses at request time.
  url               = env("DATABASE_URL")
  // Direct (unpooled) connection — Prisma's migration engine uses this
  // automatically for `migrate deploy`/`migrate dev`/`db push` whenever it's
  // set, instead of `url`. DDL over a pgbouncer transaction-mode pooler is
  // unreliable (advisory locks, session state), so migrations must run
  // against the direct connection. Locally, where there's no pooler, this is
  // the same value as DATABASE_URL.
  directUrl         = env("DIRECT_URL")
  // `migrate dev`'s shadow-database step needs CREATEDB, which the native
  // Postgres role backing DATABASE_URL (port 5432) doesn't have. Point it at
  // the docker-compose Postgres instead (port 5433, docker-compose.yml) —
  // that container's user is a real superuser, and it's already sitting
  // there unused for exactly this workflow.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Organisational roles. Trimmed from the old Phase 1 enum: SITE_SUPERVISOR,
/// KYC_REVIEWER, LOI_PREPARER and COMPANY_SIGNATORY were scoped entirely to
/// removed modules (mobile supervisor portal, onboarding/KYC/LOI e-sign) and
/// have no other purpose, so they were dropped. The rest are real
/// organisational roles, independent of any specific module, and are kept.
///
/// FRANCHISEE is kept as the one "external" role (plan.md section 2: Site BOQ
/// is internal-only; an external role must not see the sidebar item and must
/// get 403 on /site-boq/* and /api/boq/*), even though no franchisee-facing
/// feature exists on this branch yet.
enum Role {
  FRANCHISEE
  SALES
  LEGAL
  INTERIORS
  PROJECT_MANAGER
  ACCOUNTS
  HR
  CULINARY
  MARKETING
  OPERATIONS
  MANAGEMENT
  ADMIN
}

/// AuditEvent.action. EXPORT is written by the Store Onboarding CSV export.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

/// INVITE: admin created the account with no password yet — link sets the
/// first one. RESET: existing user asked for a new one via "Forgot
/// password". Same token mechanism, different email copy + expiry window.
enum PasswordResetPurpose {
  INVITE
  RESET
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  /// Nullable: an admin-created user (see PasswordResetToken, purpose
  /// INVITE) starts with no password until they follow their setup link.
  /// login() treats a null hash the same as a wrong password — no separate
  /// error message — so this doesn't become a way to enumerate which emails
  /// exist in the system.
  passwordHash        String?
  loginFailedAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  role                Role
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                     Session[]
  passwordResetTokens          PasswordResetToken[]
  auditEvents                  AuditEvent[]
  purchaseOrders               PurchaseOrder[]
  lockedSites                  Site[]                    @relation("SiteLockedBy")
  trackerStepsCompleted        TrackerSiteStep[]         @relation("TrackerStepCompletedBy")
  trackerStepsUpdated          TrackerSiteStep[]         @relation("TrackerStepUpdatedBy")
  trackerEvidenceUploads       TrackerEvidence[]
  dashboardSiteAssignment      DashboardSiteAssignment?  @relation("DashboardSiteAssignmentUser")
  dashboardSiteAssignmentsMade DashboardSiteAssignment[] @relation("DashboardSiteAssignedBy")
  dashboardStepAssignments     DashboardStepAssignment[] @relation("DashboardStepAssignmentUser")
  dashboardStepAssignmentsMade DashboardStepAssignment[] @relation("DashboardStepAssignedBy")
  opsBoqRowsUpdated            OpsBoqRow[]               @relation("OpsBoqRowUpdatedBy")
  // --- store onboarding / KYC / LOI e-sign ---
  onboardingAsFranchisee       StoreOnboarding?          @relation("OnboardingFranchisee")
  onboardingAsSalesOwner       StoreOnboarding[]         @relation("OnboardingSalesOwner")
  onboardingFilesUploaded      OnboardingFile[]          @relation("OnboardingFileUploadedBy")
  kycSubmissionsReviewed       KycSubmission[]           @relation("KycReviewer")
  paymentsUploaded             PaymentSubmission[]       @relation("PaymentUploadedBy")
  paymentsReviewed             PaymentSubmission[]       @relation("PaymentReviewer")
  loiVersionsReleased          LoiVersion[]              @relation("LoiReleasedBy")
  esignAttemptsAsSigner        EsignAttempt[]            @relation("EsignSignerUser")
}

/// Backs both the admin "invite" flow and self-service "forgot password".
/// Same hashing discipline as Session: only tokenHash is stored, so a DB leak
/// alone can't be replayed as a live link.
model PasswordResetToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   PasswordResetPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

/// Database-backed session. The cookie holds an opaque random token; only its
/// SHA-256 hash is stored here, so a database leak alone can't be replayed as
/// a valid session.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Full audit log for login/logout and user management. Deliberately generic
/// (string entityType/entityId, no FK to a specific entity) so Site BOQ's own
/// "lightweight audit log for edits in WEBSITE_LIVE" (plan.md section 5,
/// milestone M5) can reuse this same table instead of inventing a second one.
model AuditEvent {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Denormalized actor snapshot, in addition to the actorId FK — needed for
  /// an immutable event history that survives the actor's User row changing
  /// or being deleted.
  actorEmail String
  actorName  String
  actorRole  Role

  /// Set for anything that happened under a store onboarding (its KYC, payment,
  /// LOI, e-sign attempts, files) so the onboarding timeline is one indexed
  /// lookup instead of a join across entity types. Null for everything else.
  onboardingId String?
  onboarding   StoreOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String
  action     AuditAction

  oldValue  Json?
  newValue  Json?
  reference String?
  source    String  @default("web")

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([onboardingId])
}

// ---------------------------------------------------------------------------
// Site BOQ (plan.md section 3). SHEET_LIVE import (milestone M2) is the only
// writer of Site/Category/Vendor/Item/VendorRate/SiteItem data until
// WEBSITE_LIVE edit mode (M5). PurchaseOrder/PoLine are schema-only until M6.
// ---------------------------------------------------------------------------

enum CategoryGroup {
  OPERATING
  INTERIOR
}

enum ImportRunStatus {
  IN_PROGRESS
  COMMITTED
  FAILED
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
}

model Site {
  id            String    @id @default(cuid())
  /// Stable "Site ID" column added to the sheet by Abhishek — the import's
  /// upsert key (plan.md section 7), independent of the display name.
  sourceKey     String    @unique
  name          String    @unique
  shortCode     String?
  openingDate   DateTime?
  note          String?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  /// Site BOQ and Site Tracker (site-tracker-plan.md section 3) share this
  /// one Site table. Each module's own on/off switch, independent of
  /// isActive: the BOQ import only ever sets/toggles usedInBoq (never
  /// isActive) when a site isn't in a push; the tracker seed only sets
  /// usedInTracker. Existing rows default usedInBoq = true (every Site that
  /// predates the tracker was a BOQ site); usedInTracker defaults false.
  usedInBoq     Boolean   @default(true)
  usedInTracker Boolean   @default(false)
  /// Set to the current ImportRun.id on every chunk that touches this row;
  /// finish() soft-deactivates any active Site whose lastSeenRunId doesn't
  /// match the run that just completed (plan.md section 7, "finish").
  lastSeenRunId String?
  /// Site lock (plan.md section 3 "Site lock", milestone M5). Website-native
  /// data — the import must never write these fields. While isLocked, every
  /// SiteItem.qty/remarkSize/rateOverride/tracking-field edit is rejected for
  /// every role, and the sheet import skips this site's qty/tracking fields
  /// instead of overwriting them (with a warning).
  isLocked      Boolean   @default(false)
  lockedAt      DateTime?
  lockedById    String?
  lockedBy      User?     @relation("SiteLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  /// Sheet-sync's own "order delivered/locked" flag from the TULSI sheet
  /// (docs/sheet-sync/CLAUDE_CODE_HANDOFF.md section 4: `lockedSites[]`) —
  /// purely informational (shows a badge), NOT the website's isLocked above.
  /// Unlike isLocked, this never blocks a sync from writing this site's
  /// qty/tracking data; only sheet-sync itself ever sets it.
  sheetLocked   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  siteItems        SiteItem[]
  purchaseOrders   PurchaseOrder[]
  trackerSiteSteps TrackerSiteStep[]
  opsBoqRows       OpsBoqRow[]
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  displayName String
  group       CategoryGroup
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items           Item[]
  categoryVendors CategoryVendor[]
  purchaseOrders  PurchaseOrder[]
}

/// Vendor contact details (address/gstin/phone/email) are never populated by
/// the sheet import — plan.md section 7 is explicit that import must never
/// overwrite them, since they're filled in later via the UI and feed POs.
model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  gstin     String?
  phone     String?
  email     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryVendors CategoryVendor[]
  vendorRates     VendorRate[]
  finalForItems   Item[]           @relation("ItemFinalVendor")
  purchaseOrders  PurchaseOrder[]
}

model CategoryVendor {
  categoryId String
  vendorId   String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([categoryId, vendorId])
  @@index([vendorId])
}

model Item {
  id            String   @id @default(cuid())
  /// Stable "Item ID" column added to the sheet by Abhishek — the import's
  /// upsert key. Falls back to category+name+occurrence index with a warning
  /// when absent (plan.md section 7).
  sourceKey     String   @unique
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name          String
  sizeNote      String?
  finalVendorId String?
  finalVendor   Vendor?  @relation("ItemFinalVendor", fields: [finalVendorId], references: [id], onDelete: SetNull)
  note          String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// See Site.lastSeenRunId.
  lastSeenRunId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos      ItemPhoto[]
  vendorRates VendorRate[]
  siteItems   SiteItem[]
  poLines     PoLine[]

  @@index([categoryId])
}

model ItemPhoto {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  storageKey String
  /// Also the import's idempotency key (plan.md section 7: "idempotent by
  /// itemKey + index") — slot 0-2 of that item's photos, re-push replaces
  /// whatever already occupies this slot rather than appending.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([itemId, sortOrder])
}

/// rate nullable + 0 both mean "missing" (plan.md section 3, Rate rules) —
/// 0/empty incoming values are normalized to null before being stored here,
/// never stored as 0.
model VendorRate {
  id        String   @id @default(cuid())
  itemId    String
  vendorId  String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rate      Decimal? @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, vendorId])
  @@index([vendorId])
}

/// One row per (site, item) that has at least one non-empty field — import
/// never creates an all-empty row (plan.md section 3). rateOverride is never
/// written by import (the sheet has one rate for all sites); it exists for
/// the future per-site override the UI will support.
model SiteItem {
  id           String   @id @default(cuid())
  siteId       String
  itemId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty          Decimal  @default(0) @db.Decimal(12, 2)
  remarkSize   String?
  rateOverride Decimal? @db.Decimal(14, 2)
  /// Snapshot of effective_rate taken when the parent Site was locked (plan.md
  /// section 3 "Site lock"). While the site is locked, amount = qty ×
  /// lockedRate, so later changes to the item's rate don't move a locked
  /// site's numbers. Cleared back to null on unlock. Never written by import.
  lockedRate   Decimal? @db.Decimal(14, 2)
  poAmount     Decimal? @db.Decimal(14, 2)
  boqLink      String?
  poLink       String?
  approvedVia  String?
  link         String?
  advanceGiven Decimal? @db.Decimal(14, 2)
  stage        String?
  followUp     String?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([siteId, itemId])
  @@index([itemId])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  siteId          String
  categoryId      String
  vendorId        String
  site            Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  poDate          DateTime
  deliveryBy      DateTime?
  deliveryDays    Int
  paymentTerms    String
  gstPercent      Decimal             @db.Decimal(5, 2)
  subtotal        Decimal             @db.Decimal(14, 2)
  gstAmount       Decimal             @db.Decimal(14, 2)
  total           Decimal             @db.Decimal(14, 2)
  status          PurchaseOrderStatus @default(DRAFT)
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Snapshots of company/vendor/site details as they were at PO creation
  /// time (plan.md section 3) — the PDF must not change retroactively if the
  /// live Vendor/Site/settings rows are edited later.
  companySnapshot Json
  vendorSnapshot  Json
  siteSnapshot    Json
  termsSnapshot   Json
  createdAt       DateTime            @default(now())

  lines PoLine[]

  @@index([siteId])
  @@index([vendorId])
  @@index([categoryId])
}

model PoLine {
  id              String        @id @default(cuid())
  poId            String
  po              PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId          String?
  item            Item?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  nameSnapshot    String
  remarkSize      String?
  qty             Decimal       @db.Decimal(12, 2)
  rate            Decimal       @db.Decimal(14, 2)
  amount          Decimal       @db.Decimal(14, 2)
  photoStorageKey String?

  @@index([poId])
}

/// Generic key/value settings store (plan.md section 3) so new settings can
/// be added without a migration. Known keys are seeded in M1 (see
/// prisma/seed.ts) and read through src/lib/app-settings.ts, not accessed
/// directly — that module is the single place that knows the key names and
/// value shapes.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// One row per import push (plan.md section 7's begin/chunk/photo/finish
/// sequence, OR docs/sheet-sync/CLAUDE_CODE_HANDOFF.md's start/chunk/finish
/// sequence). counts/warnings are only populated once finish() commits.
model ImportRun {
  id           String          @id @default(cuid())
  status       ImportRunStatus @default(IN_PROGRESS)
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  counts       Json?
  warnings     Json?
  dryRun       Boolean         @default(false)
  /// Sheet-sync additions (docs/sheet-sync/CLAUDE_CODE_HANDOFF.md) — all null
  /// for the old M2 push-import rows; set for every run created via
  /// POST /api/sheet-sync/start. trigger is 'button'|'daily'|'menu';
  /// requestId links back to the AppSetting "sheetSyncRequest" singleton
  /// that spawned this run; errorMessage is the human-readable failure
  /// reason shown by GET /status and the failure email.
  trigger      String?
  requestId    String?
  errorMessage String?
  /// start.sites[]/lockedSites[] — small (～17 rows today), kept directly on
  /// the run rather than chunked into staging since finish only needs it
  /// once, unlike the 21 per-category chunks below.
  sitesPayload Json?

  stagingChunks BoqSyncStagingChunk[]
}

/// Sheet-sync staging (docs/sheet-sync/CLAUDE_CODE_HANDOFF.md section 0):
/// POST /api/sheet-sync/chunk writes here, keyed by (runId, category) so a
/// retried chunk (the script retries on 5xx) replaces rather than
/// duplicates. Live Site BOQ tables are untouched until finish reads every
/// row for the run and commits in one transaction; fail (or a reaped,
/// timed-out run) just deletes these rows, leaving live data exactly as it
/// was before the run started.
model BoqSyncStagingChunk {
  id        String    @id @default(cuid())
  runId     String
  run       ImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  category  String
  payload   Json
  createdAt DateTime  @default(now())

  @@unique([runId, category])
}

// ---------------------------------------------------------------------------
// Site Tracker (site-tracker-plan.md section 3). Separate module from Site
// BOQ above, sharing only the Site table (via usedInTracker). The seed
// (prisma/seed-data/site-tracker-steps.json) is the only writer of
// TrackerSection/TrackerStep; TrackerSiteStep rows are created lazily by the
// edit API (site-tracker-plan.md section 3: "no row = NOT_STARTED").
// ---------------------------------------------------------------------------

enum TrackerStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_REQUIRED
}

enum TrackerEvidenceKind {
  IMAGE
  VIDEO
}

model TrackerSection {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps TrackerStep[]
}

model TrackerStep {
  id        String         @id @default(cuid())
  sectionId String
  section   TrackerSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  /// The sheet's own step code (e.g. "7.2.1") — non-contiguous on purpose,
  /// never renumbered. The seed's upsert key.
  code      String         @unique
  name      String
  order     Int
  isActive  Boolean        @default(true)
  /// True for the one step manufactured for "Deep Cleaning" (site-tracker-
  /// plan.md's seed comment: a section with no sub-steps in the sheet).
  synthetic Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  siteSteps TrackerSiteStep[]

  @@index([sectionId])
}

/// One row per (site, step) that has ever been touched — lazy: no row means
/// NOT_STARTED (site-tracker-plan.md section 3). Rules enforced on the
/// server, not here (section 4): COMPLETED needs >= 1 evidence unless
/// legacyCompleted; evidence delete can't drop a COMPLETED non-legacy step to
/// zero evidence.
model TrackerSiteStep {
  id                String            @id @default(cuid())
  siteId            String
  site              Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stepId            String
  step              TrackerStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status            TrackerStepStatus @default(NOT_STARTED)
  assignee          String?
  remark            String?
  notRequiredReason String?
  completedAt       DateTime?
  completedById     String?
  completedBy       User?             @relation("TrackerStepCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  /// Set for rows created by the Phase 2 import (site-tracker-plan.md section
  /// 7): "imported COMPLETED -> legacyCompleted = true (exempt from evidence
  /// rule)" — the sheet's own history has no photos to backfill.
  legacyCompleted   Boolean           @default(false)
  updatedById       String?
  updatedBy         User?             @relation("TrackerStepUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  evidence TrackerEvidence[]

  @@unique([siteId, stepId])
  @@index([stepId])
}

model TrackerEvidence {
  id           String              @id @default(cuid())
  siteStepId   String
  siteStep     TrackerSiteStep     @relation(fields: [siteStepId], references: [id], onDelete: Cascade)
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  kind         TrackerEvidenceKind
  uploadedById String?
  uploadedBy   User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([siteStepId])
}

// ---------------------------------------------------------------------------
// Dashboard (dashboard-sheet-sync-plan.md). Separate "Site Drawing Updates"
// sheet from the Site BOQ ("TULSI Rate Sheet") one, so this has its own Site
// table (DashboardSite) rather than reusing the shared Site model above —
// the two sheets' site lists aren't guaranteed to match 1:1 (this one
// includes trash/Zoca sites). Read-only product: nothing here is ever
// written back to the sheet, and there is no SHEET_LIVE/WEBSITE_LIVE mode —
// the website only ever displays the last synced copy.
// ---------------------------------------------------------------------------

enum DashboardStepStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NOT_REQUIRED
}

/// One sync run (mirrors ImportRun's role, kept fully separate so a bug in
/// one sync can't touch the other's rows). trigger is 'button'|'daily'; no
/// 'menu' trigger for Dashboard (dashboard-sheet-sync-plan.md doesn't mention
/// a sheet-menu option, unlike Site BOQ's).
model DashboardSyncRun {
  id               String          @id @default(cuid())
  status           ImportRunStatus @default(IN_PROGRESS)
  trigger          String?
  requestId        String?
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?
  errorMessage     String?
  counts           Json?
  warnings         Json?
  /// Per-site diff between our computed numbers and the sheet's own
  /// Dashboard-tab sheetSummary (dashboard-sheet-sync-plan.md section 5),
  /// shown to internal roles only.
  mismatches       Json?
  /// start.deptLinks[] (small — the whole Department Links tab) — held here
  /// until finish() applies the full replace, same reasoning as ImportRun.
  /// sitesPayload: a transaction can't span the separate start/chunk/finish
  /// HTTP calls, so anything finish needs rides on the run row itself.
  deptLinksPayload Json?

  stagingChunks DashboardSyncStagingChunk[]
}

/// POST /api/dashboard-sync/chunk writes here, one row per (run, site) — a
/// retried chunk (script retries on 5xx) replaces rather than duplicates.
/// Live Dashboard tables are untouched until finish commits in one
/// transaction; fail/reap just deletes these rows.
model DashboardSyncStagingChunk {
  id        String           @id @default(cuid())
  runId     String
  run       DashboardSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  siteName  String
  payload   Json
  createdAt DateTime         @default(now())

  @@unique([runId, siteName])
}

/// Where a DashboardSite row came from. WEBSITE sites are created by an admin
/// on the website (src/app/(app)/dashboard/actions.ts) and are never touched by
/// the sheet sync (commit.ts skips them); SHEET sites are sync-owned.
enum DashboardSiteOrigin {
  SHEET
  WEBSITE
}

model DashboardSite {
  id             String              @id @default(cuid())
  name           String              @unique
  origin         DashboardSiteOrigin @default(SHEET)
  /// Free-text department links an admin typed in ("interiors --> https://...").
  /// Website-owned (unlike DashboardDeptLink rows, which sync wipes each run).
  deptLinksText  String?
  sortOrder      Int                 @default(0)
  driveFolderUrl String?
  /// Raw per-site numbers from the sheet's own Dashboard tab (dashboard-
  /// sheet-sync-plan.md section 3): {total, completed, inProgress,
  /// notStarted, pct, shared, notShared, perStagePct: number[13], notRequired}.
  /// Stored as-is for the mismatch check in commit(); never used to render
  /// the website's own numbers, which are always recomputed from DashboardStep.
  sheetSummary   Json?
  lastSyncedAt   DateTime?
  isActive       Boolean             @default(true)
  /// Set to the current DashboardSyncRun.id on every chunk that touches this
  /// row; finish() soft-deactivates any active site whose lastSeenRunId
  /// doesn't match the run that just completed.
  lastSeenRunId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  steps       DashboardStep[]
  deptLinks   DashboardDeptLink[]
  assignments DashboardSiteAssignment[]
  onboarding  StoreOnboarding?
}

/// One row per (site, stage, step) leaf or parent. Parents (isParent=true)
/// have status null — their displayed status is derived on read from their
/// children (dashboard-sheet-sync-plan.md section 3) — and are excluded from
/// every percentage. stepKey is the sheet row number within the stage tab,
/// stable across re-syncs unless rows are inserted/removed by hand.
model DashboardStep {
  id           String               @id @default(cuid())
  siteId       String
  site         DashboardSite        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stageNo      Int
  /// Live tab name (can be renamed in the sheet) — shown on the website as-is.
  stageName    String
  stepKey      String
  parentKey    String?
  label        String
  sortOrder    Int
  isParent     Boolean              @default(false)
  assignedTo   String?
  status       DashboardStepStatus?
  remark       String?
  shared       Boolean              @default(false)
  /// [{name, url}] parsed from the sheet's HYPERLINK formula(s) or rich text runs.
  deliverables Json                 @default("[]")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  assignments DashboardStepAssignment[]

  @@unique([siteId, stageNo, stepKey])
  @@index([siteId])
}

/// Task-level "this person works on this step" (plan.md section 12). Admin sets
/// these on the Team page of a WEBSITE-origin site; a user can open a stage iff
/// they hold >= 1 step in it and can edit (status + remark) exactly the steps
/// they hold. Many users per step. Keyed on DashboardStep.id, which is stable
/// for WEBSITE sites (the sheet sync never rewrites them) but regenerated on
/// every sync for SHEET sites — hence assignments exist for WEBSITE sites only.
/// Website-native data, never touched by sync; cascades with the step/user.
model DashboardStepAssignment {
  id           String        @id @default(cuid())
  stepId       String
  step         DashboardStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation("DashboardStepAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?         @relation("DashboardStepAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@unique([stepId, userId])
  @@index([userId])
  @@index([stepId])
}

/// Department Links tab (dashboard-sheet-sync-plan.md section 3): Department |
/// Site | Stage | Folder link, read as plain values. siteId is resolved by
/// matching siteName at commit time (null if no DashboardSite matches yet).
model DashboardDeptLink {
  id              String         @id @default(cuid())
  department      String
  siteName        String
  siteId          String?
  site            DashboardSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  stageFolderName String
  url             String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([siteId])
}

/// Admin-assigned mapping of a franchisee user to exactly one Dashboard site
/// (dashboard-sheet-sync-plan.md section 2: "no mapping in the sheet").
/// Website-native data — never touched by sync.
model DashboardSiteAssignment {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation("DashboardSiteAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  siteId       String
  site         DashboardSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedBy   User?         @relation("DashboardSiteAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Operations BOQ (operations-boq-handoff.md). Website-owned procurement
// tracker: 11 fixed rows per site (src/lib/ops-boq-seed.ts, created by
// ensureOpsBoqRows when a site is created) plus user-added rows for that site
// only. No sheet sync; "Link" columns are plain pasted URLs, not Site BOQ links.
// Pending Amount is never stored (amount - advanceGiven, computed on read).
// ---------------------------------------------------------------------------

enum OpsBoqStatus {
  NOT_SHARED
  SHARED
}

model OpsBoqRow {
  id              String       @id @default(cuid())
  siteId          String
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Display string, not auto-renumbered (the sheet's two UTENSILS rows share "1").
  sno             String
  name            String
  isFixed         Boolean      @default(false)
  /// Stable key of a seeded row (src/lib/ops-boq-seed.ts); null for user-added
  /// rows. The unique index below makes ensureOpsBoqRows idempotent and
  /// race-safe (Postgres allows many NULLs, so added rows are unconstrained).
  fixedKey        String?
  sortOrder       Int
  vendor          String?
  boqStatus       OpsBoqStatus @default(NOT_SHARED)
  amount          Decimal?     @db.Decimal(14, 2)
  linkBoq         String?
  linkApprovedBoq String?
  linkPo          String?
  approvedVia     String?
  link            String?
  advanceGiven    Decimal?     @db.Decimal(14, 2)
  stage           String?
  followUpDate    DateTime?    @db.Date
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  updatedById     String?
  updatedBy       User?        @relation("OpsBoqRowUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([siteId, fixedKey])
  @@index([siteId, sortOrder])
}

// ---------------------------------------------------------------------------
// Store onboarding -> KYC -> payment -> LOI e-sign (ported from dev, plan.md section 13).
// Differences from dev: no FranchiseProject (LOI Complete creates a DashboardSite
// instead), no AuditEvent.onboardingId (audit uses entityType/entityId), no new Role values.
// ---------------------------------------------------------------------------

enum OnboardingAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// StoreOnboarding.onboardingStatus — section 17 "State machines". Owned by
/// src/lib/onboarding/state.ts; nothing else may set this field directly.
enum OnboardingStatus {
  AWAITING_KYC_PAYMENT
  UNDER_REVIEW
  CORRECTIONS_REQUESTED
  READY_FOR_SIGNATURE
  FRANCHISE_SIGNED
  LOI_COMPLETE
}

enum OnboardingEntityType {
  INDIVIDUAL
  COMPANY
}

/// Shared by KycSubmission.status and PaymentSubmission.status — section 17
/// "KYC and Payment review (independent)" describes one shape for both.
enum ReviewStatus {
  MISSING
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
}

enum OnboardingFileKind {
  PAN
  AADHAAR
  COMPANY_DOC
  SIGNATORY_PROOF
  PAYMENT_RECEIPT
  // plan.md 20C — seven additional KYC document kinds (SRD 8.1), all
  // optional (not added to kyc-requirements.ts's mandatory lists) until
  // Sushant ji says which are mandatory. PARTNERSHIP_DEED also covers an
  // LLP agreement; COMPANY_DOC already stands for the incorporation
  // certificate so it is not duplicated here.
  ADDRESS_PROOF
  PHOTOGRAPH
  BANK_STATEMENT
  CANCELLED_CHEQUE
  GST_CERT
  PARTNERSHIP_DEED
  OTHER_SUPPORTING
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum LoiVersionStatus {
  DRAFT
  RELEASED
  SENT_FOR_SIGNING
  FRANCHISE_SIGNED
  SIGNED
  VOID
}

enum EsignSignerRole {
  FRANCHISEE
  COMPANY
}

enum EsignAttemptStatus {
  NOT_STARTED
  SENT
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum EsignProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED_LATE
}

/// SRD section 4 minimum field list. One row per store being onboarded — the
/// "waiting room" before the store's DashboardSite exists (see section 17's mental
/// model in the build log above). Deliberately separate from DashboardSite
/// so a store that never completes signing never pollutes the Dashboard,
/// Site Tracker, BOQ or Ops BOQ (created only at LOI Complete).
model StoreOnboarding {
  id  String @id @default(cuid())
  /// Backs the human code (e.g. "F1-0001"), formatted at the application
  /// layer (formatOnboardingCode in src/lib/onboarding/ids.ts).
  seq Int    @unique @default(autoincrement())

  brand              String               @default("Tulsi")
  format             String
  proposedLocation   String
  legalApplicantName String
  entityType         OnboardingEntityType
  contactPhone       String

  /// Canonical, lower-cased, unique — P1-01's "one Workspace email = one
  /// store = one franchisee user" hard rule.
  workspaceEmail  String  @unique
  /// NOT DECIDED YET item 5 fallback (section 17): if the franchisee doesn't
  /// actually control the Workspace mailbox, invite mail goes here instead —
  /// nothing else about the flow changes. Null means "use workspaceEmail".
  invitationEmail String?

  franchiseeUserId String @unique
  franchisee       User   @relation("OnboardingFranchisee", fields: [franchiseeUserId], references: [id])
  salesOwnerId     String
  salesOwner       User   @relation("OnboardingSalesOwner", fields: [salesOwnerId], references: [id])

  accountStatus    OnboardingAccountStatus @default(INVITED)
  onboardingStatus OnboardingStatus        @default(AWAITING_KYC_PAYMENT)
  /// Denormalized mirror of the current KycSubmission/PaymentSubmission
  /// status, kept in sync transactionally by src/lib/onboarding/state.ts
  /// whenever the underlying row's status changes — a query convenience for
  /// list/queue screens, not the source of truth (the submission rows are).
  kycStatus        ReviewStatus            @default(MISSING)
  paymentStatus    ReviewStatus            @default(MISSING)

  /// Paise (integer), never float — per section 17's own data-model note.
  expectedAmount Int

  currentLoiVersionId String?     @unique
  currentLoiVersion   LoiVersion? @relation("CurrentLoiVersion", fields: [currentLoiVersionId], references: [id], onDelete: SetNull)

  /// Set once, at conversion (LOI Complete) — idempotency guard for the
  /// conversion transaction. The DashboardSite (+ linked tracker/BOQ Site)
  /// that LOI Complete creates for this store (src/lib/onboarding/conversion.ts).
  /// SetNull so Admin "Delete site" never blocks on / cascades into onboarding.
  dashboardSiteId String?        @unique
  dashboardSite   DashboardSite? @relation(fields: [dashboardSiteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files       OnboardingFile[]
  kyc         KycSubmission?
  payments    PaymentSubmission[]
  loiVersions LoiVersion[]        @relation("OnboardingLoiVersions")
  auditEvents AuditEvent[]

  @@index([franchiseeUserId])
  @@index([salesOwnerId])
  @@index([kycStatus])
  @@index([onboardingStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

/// KYC + payment-receipt files. Deliberately NOT the Document table (which
/// requires a project_id that doesn't exist yet, and is visible through the
/// department matrix — far too broad for Aadhaar). B2 key prefix
/// `onboarding/{onboardingId}/...`. Re-upload supersedes, never deletes —
/// same version-chain shape as Document.
model OnboardingFile {
  id           String             @id @default(cuid())
  onboardingId String
  onboarding   StoreOnboarding    @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  kind         OnboardingFileKind
  version      Int                @default(1)

  supersedesId String?         @unique
  supersedes   OnboardingFile? @relation("OnboardingFileVersion", fields: [supersedesId], references: [id])
  supersededBy OnboardingFile? @relation("OnboardingFileVersion")

  b2Key     String
  fileName  String
  mimeType  String
  sizeBytes Int
  sha256    String

  /// Nothing is reviewable until CLEAN (P1-04) — enforced in the review
  /// queue queries/actions, not just the UI.
  scanStatus ScanStatus @default(PENDING)
  scanError  String?

  uploadedById String
  uploadedBy   User   @relation("OnboardingFileUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  paymentSubmission PaymentSubmission?

  @@index([onboardingId, kind])
}

/// One row per onboarding (status cycles; the file version history lives on
/// OnboardingFile, not here). PAN number is stored encrypted at app level
/// (AES-GCM) — only panNumberEncrypted is on this row; decryption + display
/// is gated to KYC_REVIEWER/ADMIN in application code, never in a query
/// result sent to any other role.
model KycSubmission {
  id           String          @id @default(cuid())
  onboardingId String          @unique
  onboarding   StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  panNumberEncrypted String?
  panName            String?
  /// Only ever the last 4 digits — never the full Aadhaar number, never
  /// OTP/biometric (P1-04, section 17's own hard rule).
  aadhaarHolderName  String?
  aadhaarLast4       String?

  // COMPANY entityType fields (section 17 KYC list default, kyc-requirements.ts).
  companyName             String?
  companyPan              String?
  authorisedSignatoryName String?

  status         ReviewStatus @default(MISSING)
  reviewerId     String?
  reviewer       User?        @relation("KycReviewer", fields: [reviewerId], references: [id])
  decisionReason String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A resubmission creates a new row (section 17: "history is kept") — the
/// most recent row for an onboarding is the active one. Flags are computed at
/// submission time and stored so the review queue doesn't need to
/// re-derive them per render.
model PaymentSubmission {
  id             String          @id @default(cuid())
  onboardingId   String
  onboarding     StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  declaredAmount Int
  paymentDate    DateTime
  mode           String
  utr            String

  receiptFileId String         @unique
  receiptFile   OnboardingFile @relation(fields: [receiptFileId], references: [id])

  status         ReviewStatus @default(SUBMITTED)
  verifiedAmount Int?
  verifiedDate   DateTime?
  bankReference  String?

  accountsActorId String?
  accountsActor   User?     @relation("PaymentReviewer", fields: [accountsActorId], references: [id])
  decisionReason  String?
  decidedAt       DateTime?

  /// DUPLICATE_UTR / AMOUNT_MISMATCH (section 17, P1-05) — a string array
  /// rather than a new enum-per-flag table, since flags are just informational
  /// badges on the review item, not a workflow of their own.
  flags String[] @default([])

  uploadedById String
  uploadedBy   User   @relation("PaymentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([onboardingId])
  @@index([utr])
}

/// Admin-managed template versions. The placeholder shipped with this build
/// has isApproved=false, isPlaceholder=true — see LOI engine notes.
model LoiTemplate {
  id             String   @id @default(cuid())
  version        Int
  name           String
  body           String
  requiredFields Json
  isApproved     Boolean  @default(false)
  isPlaceholder  Boolean  @default(true)
  createdAt      DateTime @default(now())

  loiVersions LoiVersion[]

  @@unique([name, version])
}

/// One row per LOI revision for a store (1.0, 1.1, ...). Released versions
/// are immutable — any change is a new row, never an in-place edit past
/// RELEASED (section 17: "A released version is immutable").
model LoiVersion {
  id              String          @id @default(cuid())
  onboardingId    String
  onboarding      StoreOnboarding @relation("OnboardingLoiVersions", fields: [onboardingId], references: [id], onDelete: Cascade)
  /// "1.0", "1.1", ... — string, not a float, so "1.10" can't collide with
  /// float-precision surprises against "1.1".
  versionNo       String
  templateId      String
  template        LoiTemplate     @relation(fields: [templateId], references: [id])
  templateVersion Int
  values          Json
  /// plan.md section 19 L3: per-version wording overrides, section marker
  /// (e.g. "FEES", "SERVICES") -> replacement text. The template's own
  /// `body` is never changed by an edit; a key's absence here means "use
  /// the template's own text for that section" (the "reset to template"
  /// behaviour is simply deleting the key). Only ever set/changed while
  /// `status = DRAFT` — frozen the same moment `values`/the PDF bytes are.
  bodyOverrides   Json?

  pdfB2Key  String
  /// Immutable once written — the hash of the exact bytes sent for signing
  /// (section 17: "PDF sha256 stored").
  pdfSha256 String

  status LoiVersionStatus @default(DRAFT)

  generatedAt  DateTime  @default(now())
  releasedById String?
  releasedBy   User?     @relation("LoiReleasedBy", fields: [releasedById], references: [id])
  releasedAt   DateTime?

  signedPdfB2Key   String?
  signedPdfSha256  String?
  certificateB2Key String?

  /// plan.md section 19 L5, edge case 2: a backup of what Leegality holds
  /// right after the franchisee signs, taken because the shared document can
  /// later be voided (a new version, or a restart after the company's link
  /// expires) and would otherwise be unrecoverable. Leegality-only; never set
  /// by the mock provider. Not the final signed PDF — only one signature.
  franchiseeSignedPdfB2Key  String?
  franchiseeSignedPdfSha256 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentFor StoreOnboarding? @relation("CurrentLoiVersion")
  attempts   EsignAttempt[]

  @@unique([onboardingId, versionNo])
  @@index([onboardingId])
}

/// One row per signer per LOI version, restartable (attemptNo increments on
/// retry after FAILED/EXPIRED/CANCELLED — section 17: "A failed/expired
/// attempt can be restarted as attempt n+1").
model EsignAttempt {
  id                 String             @id @default(cuid())
  loiVersionId       String
  loiVersion         LoiVersion         @relation(fields: [loiVersionId], references: [id], onDelete: Cascade)
  signerRole         EsignSignerRole
  attemptNo          Int
  provider           String
  providerEnvelopeId String?
  /// plan.md section 19 L4/L5: under decision 4 (one shared Leegality
  /// document, two invitees) this attempt's own signUrl — set on BOTH the
  /// FRANCHISEE and COMPANY rows from the one shared createEnvelope call.
  /// Lets startCompanyEsign (step L5) reuse the company's link without a
  /// second provider call, and lets the webhook processor tell the two
  /// signers' events apart (they share the same providerEnvelopeId). Server-
  /// only: never sent to the wrong user, never logged (a signUrl is a bearer
  /// secret). Unused by the mock provider, which still gets its own envelope
  /// per attempt.
  providerSignUrl    String?
  /// The hash of the PDF actually sent for this attempt — checked against
  /// the webhook's reported hash before ever marking COMPLETED.
  pdfSha256          String
  status             EsignAttemptStatus @default(NOT_STARTED)
  signerUserId       String?
  signerUser         User?              @relation("EsignSignerUser", fields: [signerUserId], references: [id])
  sentAt             DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  events EsignEvent[]

  @@unique([loiVersionId, signerRole, attemptNo])
  @@index([loiVersionId])
  @@index([providerEnvelopeId])
}

/// Raw webhook/reconcile log — the idempotency ledger. Unique
/// (provider, providerEventId) is what makes a duplicate delivery a no-op
/// (P1-10, "duplicate and late webhooks harmless").
model EsignEvent {
  id               String                @id @default(cuid())
  attemptId        String?
  attempt          EsignAttempt?         @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  provider         String
  providerEventId  String
  envelopeId       String
  payload          Json
  signatureValid   Boolean
  processingStatus EsignProcessingStatus @default(RECEIVED)
  error            String?
  receivedAt       DateTime              @default(now())

  @@unique([provider, providerEventId])
  @@index([envelopeId])
  @@index([attemptId])
}

/// Seeded set of keys (section 17 "Emails" + the weekly "board_digest" key),
/// editable by Admin.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// "Failure of email/notification never fails the business action" (P1-14) —
/// every send attempt (success or failure) is logged here instead.
model NotificationLog {
  id           String   @id @default(cuid())
  templateKey  String
  to           String
  onboardingId String?
  status       String
  error        String?
  sentAt       DateTime @default(now())

  @@index([onboardingId])
}
