enum OnboardingAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// StoreOnboarding.onboardingStatus — section 17 "State machines". Owned by
/// src/lib/onboarding/state.ts; nothing else may set this field directly.
enum OnboardingStatus {
  AWAITING_KYC_PAYMENT
  UNDER_REVIEW
  CORRECTIONS_REQUESTED
  READY_FOR_SIGNATURE
  FRANCHISE_SIGNED
  LOI_COMPLETE
}

enum OnboardingEntityType {
  INDIVIDUAL
  COMPANY
}

/// Shared by KycSubmission.status and PaymentSubmission.status — section 17
/// "KYC and Payment review (independent)" describes one shape for both.
enum ReviewStatus {
  MISSING
  SUBMITTED
  CHANGES_REQUESTED
  ACCEPTED
}

enum OnboardingFileKind {
  PAN
  AADHAAR
  COMPANY_DOC
  SIGNATORY_PROOF
  PAYMENT_RECEIPT
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum LoiVersionStatus {
  DRAFT
  RELEASED
  SENT_FOR_SIGNING
  FRANCHISE_SIGNED
  SIGNED
  VOID
}

enum EsignSignerRole {
  FRANCHISEE
  COMPANY
}

enum EsignAttemptStatus {
  NOT_STARTED
  SENT
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum EsignProcessingStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED_LATE
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// SRD section 8: "User / Organisation — user_id, organisation, role,
/// permissions, contact, project access". Organisation/multi-org access is
/// out of scope for Phase 1 (single-brand, plan.md section 5 decisions).
model User {
  id    String  @id @default(cuid())
  name  String
  /// Optional as of plan.md section 16 (2026-09-24): a site supervisor logs
  /// in with phone+PIN and may have no email at all. Still unique when
  /// present — Postgres allows multiple NULLs under a unique constraint, so
  /// this doesn't collide across supervisor accounts. Every pre-existing user
  /// keeps their email untouched; this migration only widens the column.
  email String? @unique
  /// Site-supervisor login credential (plan.md section 16, decision 7: phone
  /// + PIN, no OTP/SMS). Hashed the same way as passwordHash — never store
  /// the raw PIN. Null for every non-supervisor account.
  phone String? @unique
  /// Nullable: an admin-created user (see PasswordResetToken, purpose
  /// INVITE) starts with no password until they follow their setup link.
  /// login() treats a null hash the same as a wrong password — no separate
  /// error message — so this doesn't become a way to enumerate which emails
  /// exist in the system.
  passwordHash String?
  /// Hashed PIN for phone-based supervisor login (plan.md section 16). Same
  /// null-means-"can't log in yet" discipline as passwordHash.
  pinHash      String?
  /// Brute-force lockout for phone+PIN login (plan.md section 16, "NOT
  /// DECIDED YET" item 3, resolved 2026-09-24: 5 wrong attempts -> 15-minute
  /// lock). Reset to 0/null on a correct login, and by the admin's
  /// "Reset PIN" action. Unused by every other login path (email+password has
  /// no lockout — out of scope for this section).
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  /// Brute-force lockout for email+password login (plan.md section 17,
  /// P1-02) — same shape as pinFailedAttempts/pinLockedUntil above (5 wrong
  /// attempts -> 15 min lock, reset on success). Kept as its own pair of
  /// columns rather than reusing the PIN ones since they gate different login
  /// paths and must not interfere with each other.
  loginFailedAttempts Int       @default(0)
  loginLockedUntil    DateTime?
  role         Role
  department   Department?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions            Session[]
  ownedProjects       FranchiseProject[]     @relation("ProjectOwner")
  franchiseeProjects  FranchiseProject[]     @relation("ProjectFranchisee")
  tasksOwned          Task[]                 @relation("TaskOwner")
  tasksCreated        Task[]                 @relation("TaskCreatedBy")
  taskComments        TaskComment[]
  documentsOwned      Document[]             @relation("DocumentOwner")
  auditEvents         AuditEvent[]
  passwordResetTokens PasswordResetToken[]
  stageOverridesDone  ProjectStageOverride[]
  /// Which projects a SITE_SUPERVISOR can see/act on (plan.md section 16,
  /// decision 3: "one project = one chat"). Empty for every other role.
  projectMemberships  ProjectMember[]

  // --- plan.md section 17 (onboarding/KYC/LOI e-sign) ---
  onboardingAsFranchisee   StoreOnboarding?      @relation("OnboardingFranchisee")
  onboardingAsSalesOwner   StoreOnboarding[]     @relation("OnboardingSalesOwner")
  onboardingFilesUploaded  OnboardingFile[]      @relation("OnboardingFileUploadedBy")
  kycSubmissionsReviewed   KycSubmission[]       @relation("KycReviewer")
  paymentsUploaded         PaymentSubmission[]   @relation("PaymentUploadedBy")
  paymentsReviewed         PaymentSubmission[]   @relation("PaymentReviewer")
  loiVersionsReleased      LoiVersion[]          @relation("LoiReleasedBy")
  esignAttemptsAsSigner    EsignAttempt[]        @relation("EsignSignerUser")
}

/// Backs both the admin "invite" flow and self-service "forgot password"
/// (plan.md build log, 2026-09-18). Same hashing discipline as Session: only
/// tokenHash is stored, so a DB leak alone can't be replayed as a live link.
model PasswordResetToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   PasswordResetPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

/// Database-backed session (decision: session-based auth, plan.md section 5).
/// The cookie holds an opaque random token; only its SHA-256 hash is stored
/// here, so a database leak alone can't be replayed as a valid session.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// SRD section 8: "FranchiseProject — project_id, brand, format,
/// franchisee_id, location, target_opening, forecast_opening,
/// lifecycle_stage, health". The one entity everything else attaches to
/// (plan.md section 4) — every other Phase 1 model carries a projectId.
model FranchiseProject {
  id              String        @id @default(cuid())
  /// Autoincrementing sequence backing the human-readable project code
  /// (formatted at the application layer, e.g. "FR-00001"), kept separate
  /// from the cuid primary key used in URLs.
  seq             Int           @unique @default(autoincrement())
  /// Single-brand hardcode for Phase 1 (plan.md section 5 decision) — plain
  /// string field, not a Brand entity, so it normalizes later without
  /// breaking this relationship.
  brand           String        @default("Tulsi")
  format          String
  franchiseeId    String
  franchisee      User          @relation("ProjectFranchisee", fields: [franchiseeId], references: [id])
  location        String
  health          ProjectHealth @default(GREEN)
  targetOpening   DateTime
  forecastOpening DateTime?
  /// FR-002: "current owner and next action visible on ... dashboards".
  ownerId         String
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  nextAction      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tasks          Task[]
  documents      Document[]
  auditEvents    AuditEvent[]
  stageOverrides ProjectStageOverride[]
  members        ProjectMember[]
  /// Set only when this project was created via onboarding conversion
  /// (plan.md section 17) — null for every project created directly through
  /// /projects/new (existing Bengaluru/Ashok Vihar included).
  onboarding     StoreOnboarding?

  @@index([franchiseeId])
  @@index([ownerId])
}

/// Site-supervisor project access (plan.md section 16, decision 3: "one
/// project = one chat"). Presence of a row = that supervisor can see and
/// upload against that project on `/m`; this is the server-side gate on
/// every `/m` page/action, checked in addition to (not instead of) the
/// existing role-based checks in permissions.ts — a supervisor spanning
/// several sites gets one row per site, not a role-wide grant.
model ProjectMember {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

/// SRD section 8: "Task — task_id, project_id, module, owner, due, priority,
/// status, dependency, completion evidence". FR-003.
model Task {
  id             String           @id @default(cuid())
  projectId      String
  project        FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Department this task belongs to — added to the data model per Apoorv's
  /// 2026-09-15 review (plan.md section 4), and confirmed present in SRD
  /// section 8's own Task field list ("module").
  module         Department
  /// Which of the 13 lifecycle stages this task belongs to (added alongside
  /// `module` 2026-09-18) — orthogonal to `module`/Department: module still
  /// drives who can manage the task, lifecycleStage drives which stage tile
  /// it shows up under and feeds that stage's derived status.
  lifecycleStage LifecycleStage
  /// Position within its (project, lifecycleStage) group — drives the
  /// swappable up/down ordering in the stage dialog (2026-09-19 addition).
  /// Seeded tasks get the sheet's order; ad-hoc tasks append to the end.
  order          Int              @default(0)
  /// Construction trade / ops department roll-up axis (plan.md section 9,
  /// decided 2026-09-21) — free-text, not an enum: the real BOQ/Ops master
  /// checklist carries ~28 distinct categories (AC Work, Electrical,
  /// Carpentry, Culinary, HR, ...), too granular for the 13-value
  /// `Department` enum that `module` uses for RBAC. Orthogonal to both
  /// `module` (who can manage it) and `lifecycleStage` (which stage tile it
  /// shows under) — nullable because the original ~150-item lifecycle
  /// checklist (STAGE_TASK_TEMPLATES) predates this axis and has no
  /// category of its own.
  category       String?
  title          String
  description    String?
  ownerId        String
  owner          User             @relation("TaskOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User             @relation("TaskCreatedBy", fields: [createdById], references: [id])
  dueDate        DateTime?
  priority       TaskPriority     @default(MEDIUM)
  status         TaskStatus       @default(NOT_STARTED)

  /// Self-referencing dependency link (SRD: "dependency").
  dependsOnId String?
  dependsOn   Task?   @relation("TaskDependency", fields: [dependsOnId], references: [id])
  dependents  Task[]  @relation("TaskDependency")

  /// SRD: "completion evidence" — free-text note/link recorded on completion.
  completionEvidence String?
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  TaskComment[]
  /// Reverses plan.md section 9 decision #5 ("no Document.taskId FK") — see
  /// plan.md section 16, decision 9: a supervisor's upload attaches straight
  /// to the Task it's evidence for, not just the project.
  documents Document[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@index([lifecycleStage])
  @@index([category])
}

/// FR-003 acceptance criteria mentions comments as part of the task
/// workflow; SRD section 5 (Communication) treats task-linked comments as
/// part of that workflow too. Minimal model — no threading/mentions yet.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

/// Admin-only "force complete" escape hatch for a lifecycle stage (2026-09-18
/// addition): normally a stage's status is derived purely from its tasks
/// (see lifecycle-stage-status.ts), but the business can decide a stage is
/// done even with tasks still open (e.g. 7/11). Presence of a row = that
/// stage is force-completed for that project; deleting it reopens the stage.
model ProjectStageOverride {
  id            String           @id @default(cuid())
  projectId     String
  project       FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage         LifecycleStage
  completedById String
  completedBy   User             @relation(fields: [completedById], references: [id])
  createdAt     DateTime         @default(now())

  @@unique([projectId, stage])
  @@index([projectId])
}

/// SRD section 8: "Document — document_id, project, category, version, file,
/// status, owner, approval_ref". FR-005. Schema included now since the data
/// model is approved as a whole, but the create/upload UI is a separate
/// Phase 1 ticket per plan.md step 4 (not part of the initial vertical
/// slice) — see plan.md section 7.
model Document {
  id          String           @id @default(cuid())
  projectId   String
  project     FranchiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Nullable (plan.md section 16, decision 9 — reverses section 9 decision
  /// #5): set when a document is evidence for one specific Task (e.g. a
  /// supervisor's upload from `/m`). Null for the pre-existing project-level
  /// vault documents, which are unaffected. `onDelete: SetNull` so a document
  /// is never deleted just because the Task it was attached to is gone — it
  /// falls back to being a plain project-level document.
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  category    Department
  title       String
  version     Int              @default(1)
  /// Object key in the R2 bucket (plan.md section 5 decision). No signed
  /// URL is stored — generated on demand so access stays controlled.
  fileKey     String
  fileName    String
  fileSize    Int
  mimeType    String
  status      DocumentStatus   @default(DRAFT)
  ownerId     String
  owner       User             @relation("DocumentOwner", fields: [ownerId], references: [id])
  /// SRD: "approval_ref" — free-text stub until the Phase 2 approval engine
  /// exists (plan.md section 2).
  approvalRef String?

  /// Version history (SRD FR-005: "Latest approved version clearly
  /// identified"): each new version points back at the one it supersedes.
  supersedesId String?   @unique
  supersedes   Document? @relation("DocumentVersion", fields: [supersedesId], references: [id])
  supersededBy Document? @relation("DocumentVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([taskId])
}

/// SRD section 8: "AuditEvent — event_id, user, project, object, action,
/// old/new, timestamp, source". FR-010 — full audit log, not optional
/// (plan.md section 4 "cause -> effect that must hold").
///
/// actorEmail/actorName/actorRole are a denormalized snapshot taken at write
/// time, in addition to the actorId FK: NFR-06 requires an *immutable* event
/// history, which the FK alone can't guarantee once a user record changes or
/// is deactivated.
model AuditEvent {
  id        String            @id @default(cuid())
  projectId String?
  project   FranchiseProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// plan.md section 17: AuditEvent needs to exist during onboarding, before
  /// a FranchiseProject does — projectId and onboardingId are both nullable,
  /// app code requires at least one (writeAuditEvent enforces this; Prisma
  /// has no declarative "at least one of" constraint). Once conversion
  /// happens, prior onboarding-scoped events keep pointing at the onboarding
  /// record, not retargeted at the new project.
  onboardingId String?
  onboarding   StoreOnboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorName  String
  actorRole  Role

  entityType String
  entityId   String
  action     AuditAction

  oldValue  Json?
  newValue  Json?
  /// SRD: "reference" — free-text pointer (e.g. a related record or note).
  reference String?
  source    String  @default("web")

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([onboardingId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// plan.md section 17 — franchise onboarding, KYC, payment proof, LOI e-sign.
// ---------------------------------------------------------------------------

/// SRD section 4 minimum field list. One row per store being onboarded — the
/// "waiting room" before a FranchiseProject exists (see section 17's mental
/// model in the build log above). Deliberately separate from FranchiseProject
/// so a store that never completes signing never pollutes dashboards/
/// Action Centre/task seeding (~963 tasks) — see plan.md section 17 intro.
model StoreOnboarding {
  id  String @id @default(cuid())
  /// Backs the human code (e.g. "F1-0001"), formatted at the application
  /// layer — same pattern as FranchiseProject.seq/formatProjectCode.
  seq Int    @unique @default(autoincrement())

  /// Pre-generated on create, reused verbatim as FranchiseProject.id at LOI
  /// Complete (see step 0's "what I found" note) — never a duplicate because
  /// it's reserved once, here, and only ever consumed once.
  reservedProjectId String @unique

  brand              String               @default("Tulsi")
  format             String
  proposedLocation   String
  legalApplicantName String
  entityType         OnboardingEntityType
  contactPhone       String

  /// Canonical, lower-cased, unique — P1-01's "one Workspace email = one
  /// store = one franchisee user" hard rule.
  workspaceEmail  String  @unique
  /// NOT DECIDED YET item 5 fallback (section 17): if the franchisee doesn't
  /// actually control the Workspace mailbox, invite mail goes here instead —
  /// nothing else about the flow changes. Null means "use workspaceEmail".
  invitationEmail String?

  franchiseeUserId String @unique
  franchisee       User   @relation("OnboardingFranchisee", fields: [franchiseeUserId], references: [id])
  salesOwnerId     String
  salesOwner       User   @relation("OnboardingSalesOwner", fields: [salesOwnerId], references: [id])

  accountStatus    OnboardingAccountStatus @default(INVITED)
  onboardingStatus OnboardingStatus        @default(AWAITING_KYC_PAYMENT)
  /// Denormalized mirror of the current KycSubmission/PaymentSubmission
  /// status, kept in sync transactionally by src/lib/onboarding/state.ts
  /// whenever the underlying row's status changes — a query convenience for
  /// list/queue screens, not the source of truth (the submission rows are).
  kycStatus        ReviewStatus            @default(MISSING)
  paymentStatus    ReviewStatus            @default(MISSING)

  /// Paise (integer), never float — per section 17's own data-model note.
  expectedAmount Int

  currentLoiVersionId String?     @unique
  currentLoiVersion   LoiVersion? @relation("CurrentLoiVersion", fields: [currentLoiVersionId], references: [id], onDelete: SetNull)

  /// Set once, at conversion (LOI Complete) — idempotency guard for the
  /// conversion transaction (section 17: "skip if already set").
  projectId String?           @unique
  project   FranchiseProject? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files       OnboardingFile[]
  kyc         KycSubmission?
  payments    PaymentSubmission[]
  loiVersions LoiVersion[]        @relation("OnboardingLoiVersions")
  auditEvents AuditEvent[]

  @@index([franchiseeUserId])
  @@index([salesOwnerId])
}

/// KYC + payment-receipt files. Deliberately NOT the Document table (which
/// requires a project_id that doesn't exist yet, and is visible through the
/// department matrix — far too broad for Aadhaar). B2 key prefix
/// `onboarding/{onboardingId}/...`. Re-upload supersedes, never deletes —
/// same version-chain shape as Document.
model OnboardingFile {
  id           String             @id @default(cuid())
  onboardingId String
  onboarding   StoreOnboarding    @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  kind         OnboardingFileKind
  version      Int                @default(1)

  supersedesId String?         @unique
  supersedes   OnboardingFile? @relation("OnboardingFileVersion", fields: [supersedesId], references: [id])
  supersededBy OnboardingFile? @relation("OnboardingFileVersion")

  b2Key     String
  fileName  String
  mimeType  String
  sizeBytes Int
  sha256    String

  /// Nothing is reviewable until CLEAN (P1-04) — enforced in the review
  /// queue queries/actions, not just the UI.
  scanStatus ScanStatus @default(PENDING)
  scanError  String?

  uploadedById String
  uploadedBy   User   @relation("OnboardingFileUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  paymentSubmission PaymentSubmission?

  @@index([onboardingId])
  @@index([kind])
}

/// One row per onboarding (status cycles; the file version history lives on
/// OnboardingFile, not here). PAN number is stored encrypted at app level
/// (AES-GCM) — only panNumberEncrypted is on this row; decryption + display
/// is gated to KYC_REVIEWER/ADMIN in application code, never in a query
/// result sent to any other role.
model KycSubmission {
  id           String          @id @default(cuid())
  onboardingId String          @unique
  onboarding   StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  panNumberEncrypted String?
  panName            String?
  /// Only ever the last 4 digits — never the full Aadhaar number, never
  /// OTP/biometric (P1-04, section 17's own hard rule).
  aadhaarHolderName  String?
  aadhaarLast4       String?

  // COMPANY entityType fields (section 17 KYC list default, kyc-requirements.ts).
  companyName             String?
  companyPan              String?
  authorisedSignatoryName String?

  status         ReviewStatus @default(MISSING)
  reviewerId     String?
  reviewer       User?        @relation("KycReviewer", fields: [reviewerId], references: [id])
  decisionReason String?
  decidedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A resubmission creates a new row (section 17: "history is kept") — the
/// most recent row for an onboarding is the active one. Flags are computed at
/// submission time and stored so the review queue doesn't need to
/// re-derive them per render.
model PaymentSubmission {
  id             String          @id @default(cuid())
  onboardingId   String
  onboarding     StoreOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  declaredAmount Int
  paymentDate    DateTime
  mode           String
  utr            String

  receiptFileId String         @unique
  receiptFile   OnboardingFile @relation(fields: [receiptFileId], references: [id])

  status         ReviewStatus @default(SUBMITTED)
  verifiedAmount Int?
  verifiedDate   DateTime?
  bankReference  String?

  accountsActorId String?
  accountsActor   User?   @relation("PaymentReviewer", fields: [accountsActorId], references: [id])
  decisionReason  String?
  decidedAt       DateTime?

  /// DUPLICATE_UTR / AMOUNT_MISMATCH (section 17, P1-05) — a string array
  /// rather than a new enum-per-flag table, since flags are just informational
  /// badges on the review item, not a workflow of their own.
  flags String[] @default([])

  uploadedById String
  uploadedBy   User   @relation("PaymentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([onboardingId])
  @@index([utr])
}

/// Admin-managed template versions. The placeholder shipped with this build
/// has isApproved=false, isPlaceholder=true — see LOI engine notes.
model LoiTemplate {
  id             String  @id @default(cuid())
  version        Int
  name           String
  body           String
  requiredFields Json
  isApproved     Boolean @default(false)
  isPlaceholder  Boolean @default(true)
  createdAt      DateTime @default(now())

  loiVersions LoiVersion[]

  @@unique([name, version])
}

/// One row per LOI revision for a store (1.0, 1.1, ...). Released versions
/// are immutable — any change is a new row, never an in-place edit past
/// RELEASED (section 17: "A released version is immutable").
model LoiVersion {
  id              String          @id @default(cuid())
  onboardingId    String
  onboarding      StoreOnboarding @relation("OnboardingLoiVersions", fields: [onboardingId], references: [id], onDelete: Cascade)
  /// "1.0", "1.1", ... — string, not a float, so "1.10" can't collide with
  /// float-precision surprises against "1.1".
  versionNo       String
  templateId      String
  template        LoiTemplate     @relation(fields: [templateId], references: [id])
  templateVersion Int
  values          Json

  pdfB2Key  String
  /// Immutable once written — the hash of the exact bytes sent for signing
  /// (section 17: "PDF sha256 stored").
  pdfSha256 String

  status LoiVersionStatus @default(DRAFT)

  generatedAt DateTime  @default(now())
  releasedById String?
  releasedBy   User?     @relation("LoiReleasedBy", fields: [releasedById], references: [id])
  releasedAt   DateTime?

  signedPdfB2Key   String?
  signedPdfSha256  String?
  certificateB2Key String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentFor StoreOnboarding? @relation("CurrentLoiVersion")
  attempts   EsignAttempt[]

  @@unique([onboardingId, versionNo])
  @@index([onboardingId])
}

/// One row per signer per LOI version, restartable (attemptNo increments on
/// retry after FAILED/EXPIRED/CANCELLED — section 17: "A failed/expired
/// attempt can be restarted as attempt n+1").
model EsignAttempt {
  id                 String              @id @default(cuid())
  loiVersionId       String
  loiVersion         LoiVersion          @relation(fields: [loiVersionId], references: [id], onDelete: Cascade)
  signerRole         EsignSignerRole
  attemptNo          Int
  provider           String
  providerEnvelopeId String?
  /// The hash of the PDF actually sent for this attempt — checked against
  /// the webhook's reported hash before ever marking COMPLETED.
  pdfSha256          String
  status             EsignAttemptStatus  @default(NOT_STARTED)
  signerUserId       String?
  signerUser         User?               @relation("EsignSignerUser", fields: [signerUserId], references: [id])
  sentAt             DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  events EsignEvent[]

  @@index([loiVersionId])
  @@index([providerEnvelopeId])
  @@unique([loiVersionId, signerRole, attemptNo])
}

/// Raw webhook/reconcile log — the idempotency ledger. Unique
/// (provider, providerEventId) is what makes a duplicate delivery a no-op
/// (P1-10, "duplicate and late webhooks harmless").
model EsignEvent {
  id               String                 @id @default(cuid())
  attemptId        String?
  attempt          EsignAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  provider         String
  providerEventId  String
  envelopeId       String
  payload          Json
  signatureValid   Boolean
  processingStatus EsignProcessingStatus  @default(RECEIVED)
  error            String?
  receivedAt       DateTime               @default(now())

  @@unique([provider, providerEventId])
  @@index([envelopeId])
  @@index([attemptId])
}

/// Seeded set of 8 keys (section 17 "Emails"), editable by Admin.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// "Failure of email/notification never fails the business action" (P1-14) —
/// every send attempt (success or failure) is logged here instead.
model NotificationLog {
  id           String   @id @default(cuid())
  templateKey  String
  to           String
  onboardingId String?
  status       String
  error        String?
  sentAt       DateTime @default(now())

  @@index([onboardingId])
}
