# Copy this file to .env for local development.

# Local Postgres — points at a native Postgres install on the default port
# (5432). Requires a `fraterniti` role (password `fraterniti_dev`) owning a
# `fraterniti_one` database — see README/plan.md for the one-time setup SQL.
# Prefer Docker instead? `docker compose up -d` runs the same on host port
# 5433 (chosen to avoid clashing with a native install) — just swap the port.
DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5432/fraterniti_one?schema=public"

# `prisma migrate dev`'s shadow-database step needs a role with CREATEDB.
# If DATABASE_URL points at a native Postgres install whose role doesn't have
# that (common — see plan.md section 16's build log), point this at the
# docker-compose Postgres instead (`docker compose up -d`, host port 5433)
# — its role is a full superuser, so it can create/drop the throwaway shadow
# database `migrate dev` needs on every run. Only used during migrations,
# never by the running app.
SHADOW_DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5433/fraterniti_one_shadow?schema=public"

# Session cookie signing (openssl rand -base64 32)
SESSION_SECRET="replace-with-a-generated-32-byte-secret"

# Password applied to every account created by `npm run db:seed`
# (prisma/seed.ts) — dev/demo accounts only. Pick your own value; never
# commit the real one (this file is the only version tracked in git).
SEED_DEV_PASSWORD="replace-with-a-local-dev-password"

# Backblaze B2 (S3-compatible) — Document vault (FR-005). Switched from the
# originally planned Cloudflare R2 (plan.md section 5) because R2 requires a
# credit card on file to activate even for free-tier usage; B2 does not.
# B2_ENDPOINT is the bucket's S3-compatible endpoint shown on its bucket
# details page in the B2 console (e.g. https://s3.us-west-004.backblazeb2.com)
# — it varies per bucket/region, unlike R2's account-derived endpoint.
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""

# Resend — sends invite + password-reset emails (FR: admin user creation,
# forgot password). Get an API key from https://resend.com/api-keys.
# EMAIL_FROM must be an address on a domain verified in Resend, OR
# "onboarding@resend.dev" (Resend's shared sandbox sender — only deliverable
# to the email address your Resend account itself is signed up with, fine
# for local testing but not for real users).
RESEND_API_KEY=""
EMAIL_FROM=""

# Base URL used to build absolute links in emails (invite/reset). No trailing
# slash. Update to the real deployed URL once hosted.
APP_URL="http://localhost:3000"
