# Copy this file to .env for local development.

# Local Postgres (docker compose up -d)
DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5433/fraterniti_one?schema=public"

# Session cookie signing (openssl rand -base64 32)
SESSION_SECRET="replace-with-a-generated-32-byte-secret"

# Cloudflare R2 (S3-compatible) — Document vault (FR-005), wired up in that ticket,
# not required for the Phase 1 vertical slice.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
