# Copy this file to .env for local development.

# `new` branch (Site BOQ, see plan.md) uses its OWN, separate Postgres
# database — never point this at the main/dev database. Ask for the real
# value; this file only documents the shape.
DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5432/fraterniti_one_boq?schema=public"

# `prisma migrate dev`'s shadow-database step needs a role with CREATEDB.
# If DATABASE_URL points at a native Postgres install whose role doesn't have
# that, point this at the docker-compose Postgres instead (`docker compose up
# -d`, host port 5433) — its role is a full superuser, so it can create/drop
# the throwaway shadow database `migrate dev` needs on every run. Only used
# during migrations, never by the running app.
SHADOW_DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5433/fraterniti_one_boq_shadow?schema=public"

# Session cookie signing (openssl rand -base64 32)
SESSION_SECRET="replace-with-a-generated-32-byte-secret"

# Password applied to every account created by `npm run db:seed`
# (prisma/seed.ts) — dev/demo accounts only. Pick your own value; never
# commit the real one (this file is the only version tracked in git).
SEED_DEV_PASSWORD="replace-with-a-local-dev-password"

# Backblaze B2 (S3-compatible) — used for the auth/document-adjacent storage
# helper (src/lib/storage.ts) and, from plan.md milestone M4, Site BOQ item
# photos. B2_ENDPOINT is the bucket's S3-compatible endpoint shown on its
# bucket details page in the B2 console (e.g.
# https://s3.us-west-004.backblazeb2.com) — it varies per bucket/region.
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""

# Resend — sends invite + password-reset emails. Get an API key from
# https://resend.com/api-keys. EMAIL_FROM must be an address on a domain
# verified in Resend, OR "onboarding@resend.dev" (Resend's shared sandbox
# sender — only deliverable to the email address your Resend account itself
# is signed up with, fine for local testing but not for real users).
RESEND_API_KEY=""
EMAIL_FROM=""

# Base URL used to build absolute links in emails (invite/reset). No trailing
# slash. Update to the real deployed URL once hosted.
APP_URL="http://localhost:3000"

# plan.md section 7 — shared secret the sheet's Apps Script push sends as
# `Authorization: Bearer <IMPORT_SECRET>` on every /api/import/boq/* request.
# Not used until milestone M2 — placeholder for now (openssl rand -base64 32).
IMPORT_SECRET=""
