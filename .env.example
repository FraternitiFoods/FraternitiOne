# Copy this file to .env for local development.

# `new` branch (Site BOQ, see plan.md) uses its OWN, separate Postgres
# database — never point this at the main/dev database. Ask for the real
# value; this file only documents the shape.
DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5432/fraterniti_one_boq?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate deploy`/`dev`
# (see prisma/schema.prisma's `directUrl`). On Neon this is the "Direct
# connection" string from the dashboard (no "-pooler" in the host), not the
# pooled one DATABASE_URL should use. Locally, with no pooler in front of
# Postgres, this is just the same value as DATABASE_URL.
DIRECT_URL="postgresql://fraterniti:fraterniti_dev@localhost:5432/fraterniti_one_boq?schema=public"

# `prisma migrate dev`'s shadow-database step needs a role with CREATEDB.
# If DATABASE_URL points at a native Postgres install whose role doesn't have
# that, point this at the docker-compose Postgres instead (`docker compose up
# -d`, host port 5433) — its role is a full superuser, so it can create/drop
# the throwaway shadow database `migrate dev` needs on every run. Only used
# during migrations, never by the running app.
SHADOW_DATABASE_URL="postgresql://fraterniti:fraterniti_dev@localhost:5433/fraterniti_one_boq_shadow?schema=public"

# Session cookie signing (openssl rand -base64 32)
SESSION_SECRET="replace-with-a-generated-32-byte-secret"

# Password applied to every account created by `npm run db:seed`
# (prisma/seed.ts) — dev/demo accounts only. Pick your own value; never
# commit the real one (this file is the only version tracked in git).
SEED_DEV_PASSWORD="replace-with-a-local-dev-password"

# Backblaze B2 (S3-compatible) — used for the auth/document-adjacent storage
# helper (src/lib/storage.ts) and, from plan.md milestone M4, Site BOQ item
# photos. B2_ENDPOINT is the bucket's S3-compatible endpoint shown on its
# bucket details page in the B2 console (e.g.
# https://s3.us-west-004.backblazeb2.com) — it varies per bucket/region.
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""

# Resend — sends invite + password-reset emails. Get an API key from
# https://resend.com/api-keys. EMAIL_FROM must be an address on a domain
# verified in Resend, OR "onboarding@resend.dev" (Resend's shared sandbox
# sender — only deliverable to the email address your Resend account itself
# is signed up with, fine for local testing but not for real users).
RESEND_API_KEY=""
EMAIL_FROM=""

# Base URL used to build absolute links in emails (invite/reset). No trailing
# slash. Update to the real deployed URL once hosted.
APP_URL="http://localhost:3000"

# plan.md section 7 — shared secret the sheet's Apps Script push sends as
# `Authorization: Bearer <IMPORT_SECRET>` on every /api/import/boq/* request.
# Not used until milestone M2 — placeholder for now (openssl rand -base64 32).
IMPORT_SECRET=""

# docs/sheet-sync/CLAUDE_CODE_HANDOFF.md — separate secret for the newer
# /api/sheet-sync/* contract (WebsiteSync.js Apps Script), kept distinct from
# IMPORT_SECRET so rotating one never affects the other. Generate with:
# openssl rand -base64 32.
SHEET_SYNC_SECRET=""

# Who receives the "sheet sync failed" alert email (docs/sheet-sync/
# CLAUDE_CODE_HANDOFF.md section 7).
SHEET_SYNC_ALERT_EMAIL=""

# dashboard-sheet-sync-plan.md — separate secret for the Dashboard module's
# own /api/dashboard-sync/* contract (WebsiteSync.gs in the "Site Drawing
# Updates" sheet COPY's Apps Script project — a different sheet/script
# project from Site BOQ's, so this must be a different secret). Generate
# with: openssl rand -base64 32.
DASHBOARD_SYNC_SECRET=""

# Who receives the "dashboard sync failed" alert email. Can be the same
# address as SHEET_SYNC_ALERT_EMAIL or different — kept as its own var.
DASHBOARD_SYNC_ALERT_EMAIL=""

RESEND_API_KEY=""
EMAIL_FROM=""

# Base URL used to build absolute links in emails (invite/reset). No trailing
# slash. Update to the real deployed URL once hosted.
APP_URL="http://localhost:3000"

# plan.md section 17 — franchise onboarding, KYC, payment proof, LOI e-sign.
# ESIGN_PROVIDER: "mock" (default, dev/test only — refuses to run when
# NODE_ENV=production) or "leegality" (section 19, real Aadhaar eSign — see
# its own env vars below). ESIGN_WEBHOOK_SECRET signs/verifies the mock
# provider's webhook payload
# (openssl rand -base64 32) — the mock provider uses the same secret to sign
# the fake webhooks it fires from /dev/mock-esign.
ESIGN_PROVIDER="mock"
ESIGN_WEBHOOK_SECRET=""
# Mock signatures have no legal value (they're watermarked "TEST SIGNATURE —
# NOT LEGALLY BINDING" everywhere they appear) and are refused whenever
# NODE_ENV=production. Set this to "true" ONLY while there is no real
# franchisee relying on the signature being legally valid (e.g. pre-launch
# testing on the production deployment) — unset it again before any real LOI
# needs to be enforceable.
ALLOW_MOCK_ESIGN_IN_PRODUCTION="false"
# Company signer's own e-sign mode — configurable because the SRD leaves this
# open (plan.md section 17, "NOT DECIDED YET" #6).
COMPANY_SIGN_MODE="AADHAAR_ESIGN"
# Placeholder LOI text may only be released/sent for signing when this is
# "true" — set to "false" (or unset) once the real approved LOI template is
# loaded, so production can't accidentally send an unapproved placeholder.
ALLOW_PLACEHOLDER_LOI="true"
# AES-GCM key PAN numbers are encrypted with at rest (openssl rand -base64 32).
PAN_ENCRYPTION_KEY=""
# "basic" (dev/test only: type/magic-byte + EICAR check — refuses to run in
# production unless ALLOW_BASIC_SCANNER_IN_PRODUCTION="true") | "api" (real
# scanner, Cloudmersive Virus Scan API — see CLOUDMERSIVE_API_KEY below).
# Covers KYC docs, payment proof, Document Vault, and Complaint attachments.
# plan.md section 17 "NOT DECIDED YET" #9 — resolved 2026-10-09.
MALWARE_SCANNER="basic"
ALLOW_BASIC_SCANNER_IN_PRODUCTION="false"
# Get a key at cloudmersive.com (free tier: 600 calls/month, 10MB file cap —
# confirm current limits yourself before relying on them; BLOCKERS.md has
# the full signup/cost writeup). Only read when MALWARE_SCANNER="api".
CLOUDMERSIVE_API_KEY=""

# plan.md section 19 — LOI signing by Aadhaar eSign through Leegality (both
# signers; replaces the short-lived SMS OTP plan, dropped 2026-10-03).
# LEEGALITY_BASE_URL: production "https://app1.leegality.com/api/", sandbox
# "https://sandbox.leegality.com/api/".
LEEGALITY_BASE_URL=""
# Legacy Auth Token (dashboard.leegality.com -> Settings -> API). Sent as
# X-Auth-Token on every call. Never log, commit, or print this value.
LEEGALITY_AUTH_TOKEN=""
# Private Salt — verifies the webhook's `mac` (HMAC-SHA1 of the documentId).
# Only changes if the API is disabled and re-enabled. Never log or commit.
LEEGALITY_PRIVATE_SALT=""
# Workflow ID ("profileId") for the "Fraterniti LOI" workflow in the
# Leegality dashboard (Workflows -> Fraterniti LOI -> API payload).
LEEGALITY_PROFILE_ID=""
# Admin banner threshold for the wallet-balance check (optional, default 10).
LEEGALITY_LOW_CREDITS="10"

