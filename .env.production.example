# Every environment variable the app needs in PRODUCTION (Vercel → Project
# Settings → Environment Variables → Production). No real values — see
# README.md's "Deploy" section for where to get each one.
#
# Not listed here (dev-only, see .env.example instead): SHADOW_DATABASE_URL
# (only used by `prisma migrate dev`'s shadow database) and
# SEED_DEV_PASSWORD (only used by prisma/seed.ts, which refuses to run with
# NODE_ENV=production anyway).

# Neon — pooled connection string (hostname contains "-pooler"). Used by the
# running app at request time.
DATABASE_URL=""

# Neon — direct (non-pooled) connection string. Used only by
# `npm run db:migrate:prod` (prisma migrate deploy) — Prisma's migration
# engine always prefers this over DATABASE_URL when both are set, since DDL
# over a pgbouncer pooled connection is unreliable.
DIRECT_URL=""

# Session cookie signing (openssl rand -base64 32). The app refuses to start
# in production if this is missing or still a known placeholder value.
SESSION_SECRET=""

# Shared secret the sheet's Apps Script sends as `Authorization: Bearer
# <IMPORT_SECRET>` on every /api/import/boq/* and /api/import/tracker
# request (plan.md section 7). Generate with: openssl rand -base64 32. The
# app refuses to start in production if this is missing or still a known
# placeholder value.
IMPORT_SECRET=""

# docs/sheet-sync/CLAUDE_CODE_HANDOFF.md — separate secret for the newer
# /api/sheet-sync/* contract. Generate with: openssl rand -base64 32. Unlike
# IMPORT_SECRET/SESSION_SECRET, missing this does not block app startup —
# every /api/sheet-sync/* route just 401s until it's set (same as missing B2
# credentials only breaks file upload, not the whole app).
SHEET_SYNC_SECRET=""

# Who receives the "sheet sync failed" alert email.
SHEET_SYNC_ALERT_EMAIL=""

# The app's real URL in production, no trailing slash (e.g.
# "https://app.fraterniti.one"). Used to build absolute links in emails and
# as the metadata base URL.
APP_URL=""

# Backblaze B2 (S3-compatible) — item photos, documents, Site Tracker
# evidence. Missing any of these produces a clear error the moment someone
# tries to upload/download a file; it does not block the app from starting
# (most requests never touch storage).
B2_ENDPOINT=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""

# Resend — invite + password-reset emails. EMAIL_FROM must be an address on
# a domain verified in your Resend account.
RESEND_API_KEY=""
EMAIL_FROM=""
